[Unit]
Description=Tan Studio hosted notebook
Documentation=https://github.com/xavierroma/tan-studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tan-studio
Group=tan-studio
WorkingDirectory=/opt/tan-studio/current
EnvironmentFile=/etc/tan-studio/environment
ExecStart=/opt/tan-studio/current/bin/tan-studio-service
Restart=on-failure
RestartSec=3s
# Attachment bytes are replicated to Cloud Storage, and the service account key
# for that stays root-owned 0600 at /etc/tan-studio/litestream-gcs.json. systemd
# reads it as root and exposes a copy at %d/gcs.json readable only by this unit,
# so the unprivileged tan-studio user never gets read access to the file itself.
# The same handover the litestream unit uses; the key is in no environment file,
# no release tarball, and not in the repo.
LoadCredential=gcs.json:/etc/tan-studio/litestream-gcs.json
TimeoutStartSec=30s
TimeoutStopSec=20s
StateDirectory=tan-studio
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
